# Copy this file to ".env" (cùng thư mục này) và điền giá trị thật vào.
# File ".env" chứa bí mật — không chia sẻ, không đăng công khai.

# Lark Suite quốc tế dùng open.larksuite.com (đổi thành open.feishu.cn nếu dùng Feishu nội địa Trung Quốc)
LARK_DOMAIN=https://open.larksuite.com

# Lấy từ trang quản trị app trên Lark Open Platform
LARK_APP_ID=
LARK_APP_SECRET=

# Phải khớp CHÍNH XÁC với "Redirect URL" khai báo trong app Lark
LARK_REDIRECT_URI=http://localhost:5173/api/auth/lark/callback

# Tài khoản quản trị (trang /admin) — chỉ tạo 1 tài khoản duy nhất khi server khởi động lần đầu.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Lấy tại https://console.anthropic.com/settings/keys — dùng để chấm nội dung
# các câu tự luận (Bài 2...). Chưa điền thì hệ thống tự rơi về kiểm tra độ dài.
ANTHROPIC_API_KEY=
